rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId || hasRole('admin');
    }

    // Incidents
    match /incidents/{incidentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Anyone authenticated can report
      allow update: if hasRole('staff') || hasRole('admin') || hasRole('crisis_manager');
      allow delete: if hasRole('admin');
    }

    // Activity Log
    match /activity_log/{logId} {
      allow read: if hasRole('staff') || hasRole('admin') || hasRole('crisis_manager');
      allow create: if isAuthenticated();
    }
    
    // Venues
    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin');
    }
  }
}
